MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional: only if mongodb+srv lookups fail on your network
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Email for password reset (optional). Without SMTP_HOST the reset link is printed in the server console during development.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="NexPath <you@gmail.com>"

# AI mentor (optional: without a key the mentor says it is not set up)
# GEMINI_API_KEY=your-google-ai-studio-key
# Model names change over time; check Google's current list. Default if unset: gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash
# Optional backup model used when the main one is over quota or busy (keeps the mentor answering)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Mentor messages allowed per student per hour (default 20)
# CHAT_RATE_LIMIT_PER_HOUR=20

# Website and API on different domains (Vercel + Render)? Set this so the sign-in cookie is sent across sites (needs HTTPS).
# COOKIE_SAMESITE=none

# Behind a hosting proxy (Render, Railway, Nginx) set this to 1 so rate limits see each visitor, not the proxy
# TRUST_PROXY=1
